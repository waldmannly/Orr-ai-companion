{
  "name": "orr-ai-companion",
  "displayName": "Orr",
  "description": "Real-time AI agent activity monitor — see what your AI coding agents are actually doing",
  "version": "1.0.0",
  "publisher": "orr",
  "engines": { "vscode": "^1.85.0" },
  "categories": ["Other", "Visualization"],
  "keywords": ["ai", "agent", "monitor", "security", "copilot", "claude", "gemini"],
  "activationEvents": ["onStartupFinished"],
  "main": "./out/extension.js",
  "icon": "icon.png",
  "contributes": {
    "commands": [
      { "command": "orr.showDashboard", "title": "AL Tracker: Open Dashboard" },
      { "command": "orr.showSessionActivity", "title": "AL Tracker: Show Current Session" },
      { "command": "orr.showFileActivity", "title": "AL Tracker: Show AI Activity for This File" },
      { "command": "orr.pauseSession", "title": "AL Tracker: Pause Current Session" },
      { "command": "orr.toggleDecorations", "title": "AL Tracker: Toggle Inline Decorations" }
    ],
    "configuration": {
      "title": "Orr",
      "properties": {
        "orr.serverUrl": {
          "type": "string",
          "default": "http://127.0.0.1:3847",
          "description": "URL of the AL Tracker server"
        },
        "orr.autoStart": {
          "type": "boolean",
          "default": true,
          "description": "Automatically start the tracker server when VS Code opens"
        },
        "orr.showDecorations": {
          "type": "boolean",
          "default": true,
          "description": "Show inline decorations for AI-modified files"
        },
        "orr.showGutterIcons": {
          "type": "boolean",
          "default": true,
          "description": "Show gutter icons on AI-modified lines"
        },
        "orr.pollingInterval": {
          "type": "number",
          "default": 3000,
          "description": "Status bar polling interval in milliseconds"
        }
      }
    },
    "colors": [
      { "id": "orr.dangerBackground", "description": "Background for danger-level AI modifications", "defaults": { "dark": "#ff444420", "light": "#ff444415" } },
      { "id": "orr.warnBackground", "description": "Background for warn-level AI modifications", "defaults": { "dark": "#ffaa0020", "light": "#ffaa0015" } },
      { "id": "orr.safeBackground", "description": "Background for safe AI modifications", "defaults": { "dark": "#44ff4410", "light": "#44ff4408" } }
    ]
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "watch": "tsc -watch -p tsconfig.json",
    "package": "npx @vscode/vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0",
    "@vscode/vsce": "^3.0.0"
  }
}
