{
  "watchPaths": [],
  "sensitiveFiles": {
    "patterns": [
      "**/.env*",
      "**/*.pem",
      "**/*.key",
      "**/id_rsa*",
      "**/credentials*",
      "**/secrets*",
      "**/personal/**",
      "**/private/**"
    ],
    "exactPaths": []
  },
  "dangerousCommands": [
    "rm -rf",
    "git push --force",
    "git push -f",
    "git reset --hard",
    "DROP TABLE",
    "DROP DATABASE",
    "format C:",
    "del /f /s /q",
    "Remove-Item -Recurse -Force",
    "rmdir /s /q"
  ],
  "alerts": {
    "desktopNotifications": false,
    "minSeverity": "warn"
  },
  "dashboard": {
    "port": 3847,
    "host": "127.0.0.1"
  },
  "retention": {
    "maxAgeDays": 90,
    "maxDbSizeMB": 500
  }
}
