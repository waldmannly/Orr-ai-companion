{
  "name": "al-companion-tracker",
  "version": "0.1.0-alpha",
  "description": "AI Agent Activity Monitor — track, audit, and visualize what AI coding agents are doing",
  "main": "dist/index.js",
  "bin": {
    "al-tracker": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc && node dist/index.js",
    "test": "node tests/unit-test.mjs",
    "test:ui": "node tests/ui-test.mjs",
    "test:unit": "c8 --src dist --include dist/**/*.js node tests/unit-test.mjs",
    "test:coverage": "c8 --src dist --include dist/**/*.js --reporter text --reporter html node tests/unit-test.mjs"
  },
  "dependencies": {
    "better-sqlite3": "^11.0.0",
    "express": "^4.21.0",
    "minimatch": "^10.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "c8": "^11.0.0",
    "typescript": "^5.7.0"
  }
}
